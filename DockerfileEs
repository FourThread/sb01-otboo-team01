FROM docker.elastic.co/elasticsearch/elasticsearch:8.17.4

# 한국어 분석기 플러그인
RUN bin/elasticsearch-plugin install analysis-nori
COPY elasticsearch/plugin/hanhinsam-0.1.zip /tmp/
RUN bin/elasticsearch-plugin install --batch file:///tmp/hanhinsam-0.1.zip

COPY elasticsearch/elasticsearch.yml config/elasticsearch.yml

ENV ES_JAVA_OPTS="-Xms256m -Xmx256m -XX:+UseG1GC"