FROM amazoncorretto:17-alpine AS builder
WORKDIR /app

# Gradle Wrapper와 설정 파일 복사
COPY gradlew .
COPY gradle/ gradle/
COPY build.gradle settings.gradle ./

# 의존성 다운로드 (캐시 최적화)
RUN mkdir -p src/main/java src/main/resources
RUN ./gradlew dependencies --no-daemon --quiet

# 소스 코드 복사 및 빌드
COPY src/ src/
RUN ./gradlew clean build -x test --no-daemon --quiet

FROM amazoncorretto:17-alpine
WORKDIR /app

# 환경 변수 설정 (배치 전용)
ENV PROJECT_NAME=O-ZANG-BATCH
ARG VERSION
ARG BUILD_DATE
ARG VCS_REF
ENV PROJECT_VERSION=${VERSION}
ENV TZ=Asia/Seoul

# 빌드 정보를 레이블로 추가
LABEL maintainer="fourthread" \
      version="${VERSION}" \
      build-date="${BUILD_DATE}" \
      vcs-ref="${VCS_REF}" \
      description="O-ZANG Batch Application optimized for t2.micro" \
      instance-type="t2.micro" \
      cpu="1-vcpu" \
      memory="1gb"

# t2.micro 최적화된 JAVA_OPTS
ENV JAVA_OPTS="-Xmx512m \
    -Xms256m \
    -XX:MaxMetaspaceSize=128m \
    -XX:MetaspaceSize=64m \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -XX:+UseCompressedOops \
    -XX:+UseCompressedClassPointers \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/app/logs/heapdump.hprof \
    -XX:+UseContainerSupport \
    -XX:InitialRAMPercentage=25.0 \
    -XX:MaxRAMPercentage=75.0 \
    -Djava.security.egd=file:/dev/./urandom \
    -Dfile.encoding=UTF-8 \
    -Duser.timezone=Asia/Seoul \
    -Dspring.output.ansi.enabled=never"

# 시간대 설정 및 필수 패키지 설치
RUN apk update && apk upgrade && \
    apk add --no-cache \
        tzdata \
        curl \
        wget && \
    cp /usr/share/zoneinfo/${TZ} /etc/localtime && \
    echo "${TZ}" > /etc/timezone && \
    rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# 애플리케이션 사용자 생성
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup -s /bin/sh -D

# 로그 및 데이터 디렉토리 생성
RUN mkdir -p /app/logs /app/data && \
    chown -R appuser:appgroup /app

COPY --from=builder --chown=appuser:appgroup /app/build/libs/*.jar app.jar

# 사용자 전환
USER appuser

EXPOSE 8081

# 헬스체크 설정
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f --max-time 8 --connect-timeout 5 http://localhost:8081/batch/actuator/health || exit 1

# 배치 애플리케이션 실행
ENTRYPOINT ["sh", "-c", "\
    echo 'Starting O-ZANG Batch Application...'; \
    echo 'Version: '${PROJECT_VERSION:-unknown}; \
    echo 'Instance: t2.micro (1vCPU, 1GB RAM)'; \
    echo 'Profile: batch'; \
    echo 'Java Options: '${JAVA_OPTS}; \
    echo ''; \
    exec java ${JAVA_OPTS} -jar app.jar \
    --server.port=8081 \
    --spring.profiles.active=batch \
    --spring.application.name=${PROJECT_NAME} \
    --spring.application.version=${PROJECT_VERSION:-unknown} \
"]