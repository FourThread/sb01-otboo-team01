{
  "family": "ozang-task",
  "containerDefinitions": [
    {
      "name": "ozang-app",
      "image": "public.ecr.aws/o8x2e2q0/ozang-app:latest",
      "cpu": 1024,
      "memory": 1024,
      "memoryReservation": 512,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "dependsOn": [
        {
          "containerName": "elasticsearch",
          "condition": "HEALTHY"
        }
      ],
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "80"
        },
        {
          "name": "JAVA_OPTS",
          "value": "-Xmx768m -Xms384m -XX:MaxMetaspaceSize=192m -XX:MetaspaceSize=96m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0"        },
        {
          "name": "INSTANCE_TYPE",
          "value": "t3.small"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "ELASTICSEARCH_HOST",
          "value": "elasticsearch"
        },
        {
          "name": "ELASTICSEARCH_PORT",
          "value": "9200"
        }
      ],
      "environmentFiles": [
        {
          "value": "arn:aws:s3:::ozang-dev-bucket/ozang.env",
          "type": "s3"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "user": "appuser",
      "workingDirectory": "/app",
      "privileged": false,
      "readonlyRootFilesystem": false,
      "dockerLabels": {
        "com.ozang.jvm.heap": "768m",
        "com.ozang.memory": "2gb",
        "com.ozang.jvm.metaspace": "192m",
        "com.ozang.instance-type": "t3.small",
        "com.ozang.version": "v1.1.0",
        "com.ozang.cpu": "2-vcpu"
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 131072,
          "hardLimit": 131072
        },
        {
          "name": "nproc",
          "softLimit": 32768,
          "hardLimit": 32768
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ozang-app",
          "awslogs-create-group": "true",
          "awslogs-datetime-format": "%Y-%m-%d %H:%M:%S",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f --max-time 8 --connect-timeout 5 http://localhost:80/actuator/health/readiness || curl -f --max-time 5 --connect-timeout 3 http://localhost:80/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 12,
        "retries": 3,
        "startPeriod": 120
      },
      "systemControls": [
        {
          "namespace": "net.core.somaxconn",
          "value": "2048"
        },
        {
          "namespace": "net.ipv4.tcp_keepalive_time",
          "value": "600"
        }
      ]
    },
    {
      "name": "elasticsearch",
      "image": "public.ecr.aws/o8x2e2q0/ozang-elasticsearch:latest",
      "cpu": 512,
      "memory": 640,
      "memoryReservation": 384,
      "essential": true,
      "environment": [
        {
          "name": "discovery.type",
          "value": "single-node"
        },
        {
          "name": "cluster.name",
          "value": "ozang-cluster"
        },
        {
          "name": "node.name",
          "value": "ozang-node"
        },
        {
          "name": "network.host",
          "value": "0.0.0.0"
        },
        {
          "name": "ES_JAVA_OPTS",
          "value": "-Xms256m -Xmx256m -XX:+UseG1GC"
        },
        {
          "name": "xpack.security.enabled",
          "value": "true"
        },
        {
          "name": "ingest.geoip.downloader.enabled",
          "value": "false"
        },
        {
          "name": "HTTP_PORT",
          "value": "9200"
        }
      ],
      "environmentFiles": [
        {
          "value": "arn:aws:s3:::ozang-dev-bucket/ozang.env",
          "type": "s3"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "elasticsearch-data",
          "containerPath": "/usr/share/elasticsearch/data",
          "readOnly": false
        }
      ],
      "volumesFrom": [],
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 32768,
          "hardLimit": 32768
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ozang-elasticsearch",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:9200/_cluster/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 5,
        "startPeriod": 90
      }
    }
  ],
  "taskRoleArn": "arn:aws:iam::462740558166:role/ecsTaskRole",
  "executionRoleArn": "arn:aws:iam::462740558166:role/ecsTaskExecutionRole",
  "networkMode": "bridge",
  "volumes": [
    {
      "name": "elasticsearch-data",
      "host": {}
    }
  ],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "1536",
  "memory": "1700",
  "tags": [
    {
      "key": "Environment",
      "value": "production"
    },
    {
      "key": "InstanceType",
      "value": "t3.small"
    },
    {
      "key": "Application",
      "value": "ozang-app"
    },
    {
      "key": "Optimization",
      "value": "2vCPU-2GB"
    },
    {
      "key": "JavaVersion",
      "value": "17-stable"
    },
    {
      "key": "Elasticsearch",
      "value": "8.17.4"
    },
    {
      "key": "HealthCheck",
      "value": "enhanced"
    }
  ]
}