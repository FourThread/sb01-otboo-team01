{
  "family": "ozang-app-task",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "cpu": "1024",
  "memory": "1400",
  "executionRoleArn": "arn:aws:iam::339712858095:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::339712858095:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "ozang-app",
      "image": "public.ecr.aws/o8x2e2q0/ozang-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        },
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "JAVA_OPTS",
          "value": "-Xmx1200m -Xms600m -XX:MaxMetaspaceSize=300m -XX:MetaspaceSize=150m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseCompressedOops -XX:+UseCompressedClassPointers -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/app-heapdump.hprof -XX:+ExitOnOutOfMemoryError -XX:+UseContainerSupport -XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=75.0 -XX:MinRAMPercentage=50.0"
        },
        {
          "name": "TZ",
          "value": "Asia/Seoul"
        },
        {
          "name": "PROJECT_NAME",
          "value": "OZANG-APP"
        },
        {
          "name": "SERVER_PORT",
          "value": "80"
        },
        {
          "name": "INSTANCE_TYPE",
          "value": "t3.small"
        }
      ],
      "environmentFiles": [
        {
          "value": "arn:aws:s3:::ozang-dev-bucket/ozang.env",
          "type": "s3"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ozang-app",
          "awslogs-datetime-format": "%Y-%m-%d %H:%M:%S",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f --max-time 10 --connect-timeout 5 http://localhost:80/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 120
      },
      "memoryReservation": 700,
      "memory": 1536,
      "cpu": 1024,
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ],
      "mountPoints": []
    }
  ],
  "volumes": [],
  "placementConstraints": [
    {
      "type": "memberOf",
      "expression": "attribute:ecs.instance-type =~ t3.small"
    }
  ],
  "tags": [
    {
      "key": "Application",
      "value": "OZANG-WEB"
    },
    {
      "key": "Environment",
      "value": "production"
    },
    {
      "key": "InstanceType",
      "value": "t3.small"
    },
    {
      "key": "ServiceType",
      "value": "web-application"
    }
  ]
}