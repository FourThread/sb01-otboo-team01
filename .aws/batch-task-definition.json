{
  "family": "ozang-batch-task",
  "containerDefinitions": [
    {
      "name": "ozang-batch-app",
      "image": "public.ecr.aws/o8x2e2q0/ozang-batch:latest",
      "cpu": 512,
      "memory": 800,
      "memoryReservation": 400,
      "portMappings": [
        {
          "containerPort": 8081,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "8081"
        },
        {
          "name": "JAVA_OPTS",
          "value": "-Xmx512m -Xms256m -XX:MaxMetaspaceSize=128m -XX:MetaspaceSize=64m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseCompressedOops -XX:+UseCompressedClassPointers -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0"
        },
        {
          "name": "INSTANCE_TYPE",
          "value": "t2.micro"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "batch"
        }
      ],
      "environmentFiles": [
        {
          "value": "arn:aws:s3:::ozang-dev-bucket/ozang.env",
          "type": "s3"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ozang-batch",
          "awslogs-create-group": "true",
          "awslogs-datetime-format": "%Y-%m-%d %H:%M:%S",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "batch"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f --max-time 8 --connect-timeout 5 http://localhost:8081/batch/actuator/health || exit 1"
        ],
        "interval": 60,
        "timeout": 12,
        "retries": 3,
        "startPeriod": 120
      }
    }
  ],
  "taskRoleArn": "arn:aws:iam::462740558166:role/ecsTaskRole",
  "executionRoleArn": "arn:aws:iam::462740558166:role/ecsTaskExecutionRole",
  "networkMode": "bridge",
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "512",
  "memory": "1024",
  "tags": [
    {
      "key": "Environment",
      "value": "production"
    },
    {
      "key": "InstanceType",
      "value": "t2.micro"
    },
    {
      "key": "Application",
      "value": "ozang-batch"
    },
    {
      "key": "ServiceType",
      "value": "batch-processor"
    }
  ]
}