{
  "family": "ozang-batch-task",
  "containerDefinitions": [
    {
      "name": "ozang-batch-app",
      "image": "public.ecr.aws/o8x2e2q0/ozang-batch:latest",
      "cpu": 1024,
      "memory": 1400,
      "memoryReservation": 700,
      "portMappings": [
        {
          "containerPort": 8081,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "8081"
        },
        {
          "name": "JAVA_OPTS",
          "value": "-Xmx1024m -Xms512m -XX:MaxMetaspaceSize=256m -XX:MetaspaceSize=128m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseCompressedOops -XX:+UseCompressedClassPointers -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0"
        },
        {
          "name": "INSTANCE_TYPE",
          "value": "t3.small"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "batch"
        },
        {
          "name": "AWS_S3_BUCKET",
          "value": "ozang-prod-bucket"
        },
        {
          "name": "FILE_UPLOAD_CLOTHES_PATH",
          "value": "batch/clothes/images/"
        },
        {
          "name": "FILE_UPLOAD_PROFILES_PATH",
          "value": "batch/profiles/images/"
        },
        {
          "name": "ELASTICSEARCH_ENABLED",
          "value": "false"
        }
      ],
      "environmentFiles": [
        {
          "value": "arn:aws:s3:::ozang-dev-bucket/ozang.env",
          "type": "s3"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "user": "appuser",
      "workingDirectory": "/app",
      "privileged": false,
      "readonlyRootFilesystem": false,
      "dockerLabels": {
        "com.ozang.jvm.heap": "1024m",
        "com.ozang.memory": "2gb",
        "com.ozang.jvm.metaspace": "256m",
        "com.ozang.instance-type": "t3.small",
        "com.ozang.version": "v2.1.0",
        "com.ozang.cpu": "2-vcpu",
        "com.ozang.application": "batch-processor"
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 131072,
          "hardLimit": 131072
        },
        {
          "name": "nproc",
          "softLimit": 32768,
          "hardLimit": 32768
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ozang-batch-app",
          "awslogs-create-group": "true",
          "awslogs-datetime-format": "%Y-%m-%d %H:%M:%S",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "batch-app"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f --max-time 10 --connect-timeout 8 http://localhost:8081/batch/actuator/health/readiness || curl -f --max-time 8 --connect-timeout 5 http://localhost:8081/batch/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 12,
        "retries": 3,
        "startPeriod": 120
      },
      "systemControls": [
        {
          "namespace": "net.core.somaxconn",
          "value": "2048"
        },
        {
          "namespace": "net.ipv4.tcp_keepalive_time",
          "value": "600"
        }
      ]
    }
  ],

  "taskRoleArn": "arn:aws:iam::462740558166:role/ecsTaskRole",
  "executionRoleArn": "arn:aws:iam::462740558166:role/ecsTaskExecutionRole",
  "networkMode": "bridge",
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "1024",
  "memory": "1536",
  "tags": [
    {
      "key": "Environment",
      "value": "production"
    },
    {
      "key": "InstanceType",
      "value": "t3.small"
    },
    {
      "key": "Application",
      "value": "ozang-batch-app"
    },
    {
      "key": "ServiceType",
      "value": "batch-processor"
    },
    {
      "key": "Profile",
      "value": "batch"
    },
    {
      "key": "Optimization",
      "value": "2vCPU-2GB"
    },
    {
      "key": "JavaVersion",
      "value": "17-stable"
    },
    {
      "key": "HealthCheck",
      "value": "enhanced"
    }
  ]
}